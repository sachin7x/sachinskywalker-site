---
import Base from '../layouts/Base.astro';

const entries = [
  { date: '2026-09-03', tag: 'tools', title: 'Claude Code LSP tool wired via ENABLE_LSP_TOOL=1', note: 'Two-minute upgrade; 30-60s grep searches become 50ms precise answers. Documented in the karanbansal LSP post (issue #15619).' },
  { date: '2026-09-02', tag: 'infra', title: 'Free Claude Code proxy hits 600+ ★', note: '40+ upstream models behind one bearer, admin API for credential management, model-ID convention. Repo: free-claude-code-proxy.' },
  { date: '2026-08-30', tag: 'tools', title: 'Prime Agent 0.9.1 ships persistent Python kernel', note: 'Variables survive compaction, goals outlive turns. The first agent loop I trust for 3-hour autonomous runs.' },
  { date: '2026-08-20', tag: 'tools', title: 'Claude Code hooks ship as a first-class extension surface', note: 'Pre-tool, post-tool, stop, session-start. The right primitives for governance — no longer need to fork the binary.' },
  { date: '2026-08-13', tag: 'research', title: 'Anthropic publishes the catastrophic-remembering paper', note: 'CLAUDE.md growth is +226% per lifetime. Comment-encoded pruning is the only durable fix. Adopted locally.' },
  { date: '2026-08-09', tag: 'infra', title: 'Apple Silicon strict code-signing tightening (macOS 26)', note: 'Nested Swift helpers without a re-signed bundle fail to launch with kLSUnknownErr -10810. Re-sign or flatten.' },
];
---
<Base title="AI Tooling Timeline — Sachin SkyWalker">
  <h1 class="text-4xl font-bold tracking-tight mb-2">AI Tooling Timeline</h1>
  <p class="text-white/60 mb-12">Live index of releases that change what an autonomous coding agent can do on a local box. Signal, not noise.</p>
  <ul class="space-y-6">
    {entries.map(e => (
      <li class="border-l-2 border-accent-500/40 pl-4">
        <div class="text-xs font-mono text-white/50">{e.date} · <span class="text-accent-500">#{e.tag}</span></div>
        <div class="text-lg font-semibold mt-1">{e.title}</div>
        <p class="mt-1 text-white/70 max-w-3xl">{e.note}</p>
      </li>
    ))}
  </ul>
</Base>
