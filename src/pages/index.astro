---
import Base from '../layouts/Base.astro';

const repos = [
  { name: 'free-claude-code-proxy',  desc: 'Self-hosted proxy that gives Claude Code 40+ free upstreams through one bearer key.' },
  { name: 'free-claude-code',        desc: 'Run Claude Code, Codex, and Pi for free from your terminal.' },
  { name: 'claude-code-local',       desc: 'Run Claude Code 100% on-device with local AI on Apple Silicon.' },
  { name: 'awesome-claude-skills',   desc: 'Curated collection of skills for Claude Code and the API.' },
];

const experience = [
  {
    range: '2022 — Present',
    role: 'Director',
    org: 'Asian Marmo Private Limited',
    detail: 'Jaipur, Rajasthan.',
  },
  {
    range: '~2020 — 2022',
    role: 'Founder / Builder',
    org: 'FabricSG',
    detail: 'Premium fabric and textile business.',
  },
];

const posts = [
  { slug: 'prime-agent-autonomous-coding', title: 'Configuring Prime Agent 0.9.1 for Long-Running Autonomous Coding', date: '2026-09-03' },
  { slug: 'claude-code-lsp-enable',        title: 'The 2-Minute Claude Code Upgrade: Enabling the LSP Tool', date: '2026-09-03' },
  { slug: 'local-claude-code-proxy',       title: 'Routing Claude Code Through a Local Free Model Proxy', date: '2026-09-02' },
];
---

<Base>
  <section id="home" class="pb-16">
    <p class="font-mono text-sm text-white/50 mb-6">~/sachindohdiya $</p>
    <h1 class="text-5xl md:text-6xl font-semibold tracking-tight mb-8">Sachin Dohdiya</h1>
    <p class="text-lg text-white/80 max-w-2xl leading-relaxed">I run a marble business in Jaipur and a fabric business in Kishangarh. I also build open-source tooling for local-first AI — most of it under <a class="underline underline-offset-4 hover:text-white" href="https://github.com/sachin7x">@sachin7x</a> on GitHub.</p>
    <p class="text-lg text-white/80 max-w-2xl leading-relaxed mt-4">Outside of work: a long-time interest in bodybuilding, and a reading habit on autonomous coding agents.</p>
  </section>

  <section id="about" class="py-16 border-t border-white/10">
    <h2 class="font-mono text-sm uppercase tracking-widest text-white/50 mb-6"># about</h2>
    <p class="text-lg text-white/80 max-w-2xl leading-relaxed">Sachin Dohdiya. Based out of Kishangarh and Jaipur, Rajasthan. Director at Asian Marmo Private Limited since 2022. Built and run FabricSG, a premium fabric and textile business.</p>
  </section>

  <section id="opensource" class="py-16 border-t border-white/10">
    <h2 class="font-mono text-sm uppercase tracking-widest text-white/50 mb-6"># open source</h2>
    <ul class="space-y-5">
      {repos.map(r => (
        <li>
          <a href={`https://github.com/sachin7x/${r.name}`} class="block group">
            <div class="font-mono text-base group-hover:underline underline-offset-4">{r.name}</div>
            <p class="mt-1 text-sm text-white/60 max-w-2xl">{r.desc}</p>
          </a>
        </li>
      ))}
    </ul>
    <p class="mt-8 text-sm text-white/50">More on <a class="underline underline-offset-4 hover:text-white" href="https://github.com/sachin7x?tab=repositories">github.com/sachin7x</a>.</p>
  </section>

  <section id="experience" class="py-16 border-t border-white/10">
    <h2 class="font-mono text-sm uppercase tracking-widest text-white/50 mb-6"># experience</h2>
    <ul class="space-y-10">
      {experience.map(e => (
        <li>
          <div class="font-mono text-xs text-white/40">{e.range}</div>
          <div class="text-lg mt-1">{e.role} <span class="text-white/50">— {e.org}</span></div>
          <p class="mt-1 text-sm text-white/60">{e.detail}</p>
        </li>
      ))}
    </ul>
  </section>

  <section id="writing" class="py-16 border-t border-white/10">
    <h2 class="font-mono text-sm uppercase tracking-widest text-white/50 mb-6"># writing</h2>
    <ul class="space-y-5">
      {posts.map(p => (
        <li>
          <a href={`/blog/${p.slug}/`} class="block group">
            <div class="group-hover:underline underline-offset-4">{p.title}</div>
            <div class="font-mono text-xs text-white/40 mt-1">{p.date}</div>
          </a>
        </li>
      ))}
    </ul>
    <p class="mt-8 text-sm text-white/50"><a class="underline underline-offset-4 hover:text-white" href="/blog/">All posts →</a></p>
  </section>

  <section id="contact" class="py-16 border-t border-white/10">
    <h2 class="font-mono text-sm uppercase tracking-widest text-white/50 mb-6"># contact</h2>
    <ul class="space-y-3 text-base">
      <li><span class="font-mono text-white/40 mr-3">github</span><a class="underline underline-offset-4 hover:text-white" href="https://github.com/sachin7x">github.com/sachin7x</a></li>
      <li><span class="font-mono text-white/40 mr-3">instagram</span><a class="underline underline-offset-4 hover:text-white" href="https://www.instagram.com/sachindohdiya/">instagram.com/sachindohdiya</a></li>
      <li><span class="font-mono text-white/40 mr-3">facebook</span><a class="underline underline-offset-4 hover:text-white" href="https://www.facebook.com/fabricsg/">facebook.com/fabricsg</a></li>
    </ul>
    <p class="mt-8 text-sm text-white/50">For business enquiries, reach out via any of the channels above.</p>
  </section>
</Base>
