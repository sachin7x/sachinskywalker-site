---
import Base from '../layouts/Base.astro';

const projects = [
  { name: 'free-claude-code-proxy',  desc: 'Self-hosted proxy that gives Claude Code 40+ free upstreams through one bearer key.' },
  { name: 'free-claude-code',        desc: 'Run Claude Code, Codex, and Pi for free from your terminal.' },
  { name: 'claude-code-local',       desc: 'Run Claude Code 100% on-device with local AI on Apple Silicon.' },
  { name: 'awesome-claude-skills',   desc: 'Curated collection of skills for Claude Code and the API.' },
];

const roles = [
  {
    since: 'Since 2022',
    role: 'Director',
    org: 'Asian Marmo Private Limited',
    note: 'Jaipur, Rajasthan.',
  },
  {
    since: 'Founder',
    role: 'Builder',
    org: 'FabricSG',
    note: 'Premium fabric and textile business.',
  },
];

const posts = [
  { slug: 'prime-agent-autonomous-coding', title: 'Configuring Prime Agent 0.9.1 for Long-Running Autonomous Coding', date: '2026-09-03' },
  { slug: 'claude-code-lsp-enable',        title: 'The 2-Minute Claude Code Upgrade: Enabling the LSP Tool', date: '2026-09-03' },
  { slug: 'local-claude-code-proxy',       title: 'Routing Claude Code Through a Local Free Model Proxy', date: '2026-09-02' },
];
---

<Base>
  <section id="home" class="py-12">
    <p class="text-accent-500 font-mono text-sm mb-6">~/sachindohdiya</p>
    <h1 class="text-6xl md:text-7xl font-bold tracking-tight mb-6">Sachin Dohdiya</h1>
    <p class="text-2xl text-white/80 max-w-3xl">Building muscle, a business, and a legacy. Director at Asian Marmo, founder of FabricSG. Based out of Kishangarh and Jaipur, Rajasthan.</p>
    <div class="flex flex-wrap gap-3 mt-8">
      <a href="#work" class="px-4 py-2 rounded-md bg-accent-500 text-white text-sm font-medium hover:bg-accent-500/90">What I'm up to</a>
      <a href="#writing" class="px-4 py-2 rounded-md border border-white/20 text-sm font-medium hover:border-accent-500">Recent writing</a>
    </div>
  </section>

  <section id="work" class="py-16 border-t border-white/5">
    <h2 class="text-sm uppercase tracking-widest text-accent-500 mb-8">What I'm up to</h2>
    <div class="space-y-10">
      {roles.map(r => (
        <div>
          <div class="text-xs text-white/50 font-mono">{r.since}</div>
          <div class="text-xl font-semibold mt-1">{r.role} <span class="text-white/60">· {r.org}</span></div>
          <p class="mt-2 text-white/70">{r.note}</p>
        </div>
      ))}
    </div>
    <p class="mt-10 text-white/70 max-w-2xl">Outside of the businesses: a long-time interest in bodybuilding, an open-source hobby for local-first AI tooling, and an ongoing reading habit on autonomous coding agents.</p>
  </section>

  <section id="projects" class="py-16 border-t border-white/5">
    <h2 class="text-sm uppercase tracking-widest text-accent-500 mb-8">Open source</h2>
    <p class="text-white/70 max-w-2xl mb-6">A small selection of public repositories under my GitHub handle.</p>
    <div class="grid md:grid-cols-2 gap-4">
      {projects.map(p => (
        <a href={`https://github.com/sachin7x/${p.name}`} class="block p-5 rounded-lg border border-white/10 hover:border-accent-500 transition">
          <div class="font-mono text-accent-500">{p.name}</div>
          <p class="mt-2 text-sm text-white/70">{p.desc}</p>
        </a>
      ))}
    </div>
    <p class="mt-6 text-sm text-white/60">More on <a class="text-accent-500 hover:underline" href="https://github.com/sachin7x?tab=repositories">github.com/sachin7x</a>.</p>
  </section>

  <section id="writing" class="py-16 border-t border-white/5">
    <h2 class="text-sm uppercase tracking-widest text-accent-500 mb-8">Recent writing</h2>
    <ul class="space-y-4">
      {posts.map(p => (
        <li>
          <a href={`/blog/${p.slug}/`} class="group block">
            <div class="text-lg group-hover:text-accent-500">{p.title}</div>
            <div class="text-xs text-white/50 font-mono">{p.date}</div>
          </a>
        </li>
      ))}
    </ul>
    <p class="mt-6"><a href="/blog/" class="text-accent-500 hover:underline">All posts →</a></p>
  </section>

  <section id="contact" class="py-16 border-t border-white/5">
    <h2 class="text-sm uppercase tracking-widest text-accent-500 mb-8">Find me</h2>
    <div class="flex flex-wrap gap-5 text-sm">
      <a class="hover:text-accent-500" href="https://github.com/sachin7x">GitHub</a>
      <a class="hover:text-accent-500" href="https://www.instagram.com/sachindohdiya/">Instagram</a>
      <a class="hover:text-accent-500" href="https://www.facebook.com/fabricsg/">FabricSG on Facebook</a>
    </div>
    <p class="mt-6 text-white/50 text-sm">For business enquiries, reach out via the channels above.</p>
  </section>
</Base>
