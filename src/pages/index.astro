---
import Base from '../layouts/Base.astro';

const heroWords = ['Sachin', 'Dohdiya'];
const heroLabel = 'Director · Builder';
const heroTitle = heroWords.map((word, wi) => {
  const baseDelay = wi === 0 ? 0.4 : 0.6;
  const chars = [...word].map((c, ci) =>
    `<span class="char" style="animation-delay:${(baseDelay + ci * 0.04).toFixed(2)}s">${c}</span>`
  ).join('');
  return `<span class="word" aria-hidden="true">${chars}</span>`;
}).join(' ');

const stats = [
  { number: '10+', label: 'Years' },
  { number: '2',   label: 'Businesses' },
  { number: '1',   label: 'Family' },
  { number: '2k+', label: 'GitHub Stars' },
];

const repos = [
  { name: 'free-claude-code-proxy', stars: '600+ ★', role: 'Creator',  desc: 'Self-hosted proxy that gives Claude Code 40+ free upstreams through one bearer key.' },
  { name: 'free-claude-code',       stars: '500+ ★', role: 'Creator',  desc: 'Run Claude Code, Codex, and Pi for free from your terminal. One install, zero API keys.' },
  { name: 'claude-code-local',      stars: '400+ ★', role: 'Creator',  desc: 'Run Claude Code 100% on-device with local AI on Apple Silicon. No data leaves the box.' },
  { name: 'awesome-claude-skills',  stars: '480+ ★', role: 'Creator',  desc: 'Curated collection of 50+ verified skills for Claude Code, Claude.ai, and the API.' },
  { name: 'claude-code-hooks',      stars: '460+ ★', role: 'Creator',  desc: 'A growing collection of useful Claude Code hooks. Copy, paste, customize.' },
  { name: 'local-devin',            stars: '300+ ★', role: 'Creator',  desc: 'An open-source, local alternative to Devin AI. Powered by local Ollama models and Claude Code.' },
];

const experience = [
  { year: '2022 — Present', role: 'Director',                    company: 'Asian Marmo Private Limited', desc: 'Joined the family marble business as Director. Third-generation operation in Kishangarh and Jaipur. CIN U52390RJ2022PTC083747.' },
  { year: '~2020 — 2022',   role: 'Founder / Builder',           company: 'FabricSG',                    desc: 'Built and ran FabricSG, a premium fabric and textile business based out of Jaipur.' },
  { year: '2014 — Present', role: 'Fitness creator',             company: '@sachindohdiya',             desc: 'Mr. Rajasthan 2019. Public fitness journey since 2014. Verified creator on Instagram.' },
];

const posts = [
  { slug: 'prime-agent-autonomous-coding', title: 'Configuring Prime Agent 0.9.1 for Long-Running Autonomous Coding', date: '2026-09-03', excerpt: 'How I wired Prime Agent to a local Free Claude Code proxy with 40+ upstream models, xhigh reasoning, and bounded autonomous runs.' },
  { slug: 'claude-code-lsp-enable',        title: 'The 2-Minute Claude Code Upgrade: Enabling the LSP Tool',         date: '2026-09-03', excerpt: 'Every Claude Code user is running without LSP. The flag, the marketplace plugins, and the install.' },
  { slug: 'local-claude-code-proxy',       title: 'Routing Claude Code Through a Local Free Model Proxy',            date: '2026-09-02', excerpt: 'How I built a 600+ star self-hosted proxy that gives Claude Code 40+ free upstream models through one bearer key.' },
  { slug: 'hindcast-claude-replay',        title: 'Browse, Search, and Replay Every Claude Code Session',            date: '2026-08-28', excerpt: 'A timeline scrubber and cost ledger for every Claude Code session on your Mac. One-paste resume.' },
  { slug: 'fabricsg-jaipur',               title: 'Building a Premium Fabric Business in Jaipur',                    date: '2026-08-12', excerpt: 'Notes from running a textile business in Kishangarh. Suppliers, logistics, and the parts no one tells you.' },
  { slug: 'marble-business-third-gen',     title: 'A Third-Generation Marble Business, in Code',                    date: '2026-07-30', excerpt: 'Running a family marble business as a 28-year-old Director. What I learned in year one, and what I am changing in year three.' },
];

const contactSegments = [
  { title: 'Business',    desc: 'Marble, fabric, and trading enquiries',     cta: 'Enquire →',     href: 'https://www.facebook.com/fabricsg/' },
  { title: 'Open Source', desc: 'AI tooling, Claude Code, hobby projects',   cta: 'Collaborate →', href: 'https://github.com/sachin7x' },
  { title: 'Fitness',     desc: 'Training, nutrition, competition notes',    cta: 'Follow →',      href: 'https://www.instagram.com/sachindohdiya/' },
  { title: 'Speaking',    desc: 'Local events in Jaipur, AI meetups',        cta: 'Invite →',      href: 'https://www.instagram.com/sachindohdiya/' },
];
---

<Base>
  <!-- HOME / HERO -->
  <section id="home" class="hero" itemscope itemtype="https://schema.org/Person">
    <div class="hero-content">
      <div class="hero-label">{heroLabel}</div>
      <h1 class="hero-title" itemprop="name" aria-label={`${heroWords[0]} ${heroWords[1]}`} set:html={heroTitle} />
      <div class="hero-subtitle" itemprop="jobTitle">
        Director at <a href="https://www.instagram.com/asianmarmo/" target="_blank" rel="noopener" itemprop="worksFor" style="color:inherit; text-decoration:none; border-bottom:1px solid currentColor;">Asian Marmo</a>
      </div>
      <div class="hero-description" itemprop="description">
        I run a marble business in Jaipur and a fabric business in Kishangarh. Outside of work: a long-time interest in bodybuilding, and a hobby of open-sourcing local-first AI tooling.
      </div>
      <div class="hero-cta desktop-only">
        <a href="#contact" class="btn btn-primary">Get In Touch</a>
        <a href="/blog/" class="btn btn-secondary">Read the Writing</a>
      </div>
      <div class="hero-cta mobile-only">
        <a href="#contact" class="cta-primary">Let's talk <span class="arrow">→</span></a>
        <a href="/blog/" class="cta-secondary">Read the writing</a>
      </div>
    </div>
    <div class="scroll-indicator">
      <div class="scroll-text">Scroll</div>
      <div class="scroll-line"></div>
    </div>
  </section>

  <!-- ABOUT -->
  <section id="about" class="about" itemscope itemtype="https://schema.org/AboutPage">
    <div class="about-container">
      <div class="section-header" style="text-align:center; margin-bottom:3rem;">
        <div class="about-label" data-section="Sachin Dohdiya — Profile">About</div>
        <h2 class="about-title fade-in">Builder</h2>
      </div>
      <div class="about-stats fade-in">
        {stats.map(s => (
          <div class="stat-item">
            <div class="stat-number">{s.number}</div>
            <div class="stat-label">{s.label}</div>
          </div>
        ))}
      </div>
      <div class="about-text fade-in">
        <p>I run businesses: marble in Jaipur, fabric in Kishangarh.</p>
        <p>Not decks. Not strategies. Things that ship and work.</p>
        <p>The pattern is the same: real problem, small team, relentless focus.</p>
      </div>
    </div>
  </section>

  <!-- OPEN SOURCE -->
  <section id="opensource" class="opensource">
    <div class="opensource-container">
      <div class="section-header">
        <h2 class="section-title fade-in">Open Source</h2>
      </div>
      <div class="opensource-grid fade-in">
        {repos.map(r => (
          <a href={`https://github.com/sachin7x/${r.name}`} target="_blank" rel="noopener" class="opensource-card">
            <div class="opensource-name">{r.name}</div>
            <div class="opensource-meta">
              <span class="opensource-stars">{r.stars}</span>
              <span class="opensource-role">{r.role}</span>
            </div>
            <div class="opensource-description">{r.desc}</div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- EXPERIENCE -->
  <section id="experience" class="experience">
    <div class="experience-container">
      <div class="section-header">
        <h2 class="section-title fade-in">Experience</h2>
      </div>
      <div class="experience-timeline fade-in">
        {experience.map(e => (
          <div class="experience-item">
            <div class="experience-dot"></div>
            <div class="experience-content">
              <div class="experience-year">{e.year}</div>
              <div class="experience-role">{e.role}</div>
              <div class="experience-company">{e.company}</div>
              <div class="experience-description">{e.desc}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <script>
    // Reveal elements with .fade-in as they scroll into view (matches karanbansal.in).
    const io = new IntersectionObserver((entries) => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('visible');
          io.unobserve(e.target);
        }
      });
    }, { threshold: 0.1 });
    document.querySelectorAll('.fade-in').forEach(el => io.observe(el));
  </script>

  <!-- WRITING -->
  <section id="writing" class="writing">
    <div class="writing-container">
      <div class="section-header">
        <h2 class="section-title fade-in">Writing</h2>
      </div>
      <div class="writing-grid fade-in">
        {posts.map(p => (
          <a href={`/blog/${p.slug}/`} class="writing-card">
            <div class="writing-card-title">{p.title}</div>
            <div class="writing-card-meta">{p.date}</div>
            <div class="writing-card-excerpt">{p.excerpt}</div>
          </a>
        ))}
      </div>
      <a href="/blog/" class="writing-more fade-in">All posts →</a>
      <div class="fade-in" style="text-align:center; margin-top:2.5rem;">
        <form class="subscribe-form" action="https://buttondown.com/api/emails/embed-subscribe/sachindohdiya" method="post" target="_blank">
          <input type="email" name="email" placeholder="you@example.com" required aria-label="Email address" />
          <button type="submit">Subscribe</button>
        </form>
        <p class="subscribe-note">New posts by email. No spam, unsubscribe anytime.</p>
      </div>
    </div>
  </section>

  <!-- CONTACT -->
  <section id="contact" class="contact">
    <div class="contact-container">
      <h2 class="contact-title fade-in">Let's Build</h2>
      <div class="contact-segments fade-in">
        {contactSegments.map(s => (
          <div class="contact-segment">
            <h3 class="segment-title">{s.title}</h3>
            <p class="segment-description">{s.desc}</p>
            <a href={s.href} target="_blank" rel="noopener" class="segment-cta">{s.cta}</a>
          </div>
        ))}
      </div>
      <div class="contact-links fade-in">
        <a href="https://github.com/sachin7x" class="contact-link" target="_blank" rel="noopener">github.com/sachin7x →</a>
        <a href="https://www.instagram.com/sachindohdiya/" class="contact-link" target="_blank" rel="noopener">Instagram →</a>
        <a href="https://www.facebook.com/fabricsg/" class="contact-link" target="_blank" rel="noopener">Facebook →</a>
      </div>
    </div>
  </section>
</Base>
