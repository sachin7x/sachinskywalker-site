---
const { title = 'Sachin Dohdiya', description = 'Director at Asian Marmo Private Limited. Founder of FabricSG. Building muscle, a business, and a legacy. Based out of Kishangarh and Jaipur, Rajasthan.', image = '/og-image.svg' } = Astro.props;
const { pathname } = Astro.url;
const links = [
  { href: '/#home',        label: 'Home' },
  { href: '/#about',       label: 'About' },
  { href: '/#opensource',  label: 'Open Source' },
  { href: '/#experience',  label: 'Experience' },
  { href: '/#writing',     label: 'Writing' },
  { href: '/#contact',     label: 'Contact' },
];
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="author" content="Sachin Dohdiya" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Sachin Dohdiya" />
  <meta property="og:url" content={Astro.url} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={new URL(image, Astro.url)} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="canonical" href={Astro.url} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="alternate" type="application/rss+xml" title="Sachin Dohdiya" href="/rss.xml" />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Person",
    "@id": "https://sachinskywalker-site.vercel.app/#sachin",
    "name": "Sachin Dohdiya",
    "url": "https://sachinskywalker-site.vercel.app",
    "jobTitle": "Director, Asian Marmo Private Limited",
    "description": "Director at Asian Marmo Private Limited. Founder of FabricSG. Builder based in Kishangarh and Jaipur, Rajasthan. Mr. Rajasthan 2019. Open-sources local-first AI tooling under @sachin7x.",
    "worksFor": { "@type": "Organization", "name": "Asian Marmo Private Limited" },
    "knowsAbout": [
      "Marble Industry", "Textile Business", "Local-first AI",
      "Claude Code", "Autonomous Coding Agents", "Bodybuilding"
    ],
    "sameAs": [
      "https://github.com/sachin7x",
      "https://www.instagram.com/sachindohdiya/",
      "https://www.facebook.com/fabricsg/"
    ]
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "ProfilePage",
    "dateModified": new Date().toISOString().slice(0, 10),
    "mainEntity": { "@id": "https://sachinskywalker-site.vercel.app/#sachin" }
  })} />
</head>
<body>
  <a href="#main" class="skip-link">Skip to main content</a>
  <nav id="nav">
    <div class="nav-container">
      <a href="/" class="logo">sachindohdiya</a>
      <button class="mobile-menu-toggle" id="mobileMenuToggle" aria-label="Toggle menu" aria-expanded="false">
        <span></span>
        <span></span>
        <span></span>
      </button>
      <ul class="nav-links" id="navLinks">
        {links.map(l => (
          <li><a href={l.href}>{l.label}</a></li>
        ))}
      </ul>
    </div>
  </nav>
  <div class="mobile-menu-backdrop" id="mobileMenuBackdrop"></div>
  <main id="main">
    <slot />
  </main>
  <footer class="footer">
    <div class="footer-content">
      <p>© {new Date().getFullYear()} Sachin Dohdiya. Built with care.</p>
      <div class="footer-links">
        <a href="https://github.com/sachin7x" target="_blank" rel="noopener">github</a>
        <a href="/rss.xml">rss</a>
      </div>
    </div>
  </footer>
  <script>
    // Nav scrolled state
    const nav = document.getElementById('nav');
    if (nav) {
      const onScroll = () => nav.classList.toggle('scrolled', window.scrollY > 50);
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();
    }
    // Mobile menu
    const toggle = document.getElementById('mobileMenuToggle');
    const links = document.getElementById('navLinks');
    const backdrop = document.getElementById('mobileMenuBackdrop');
    function setMenu(open) {
      toggle?.classList.toggle('active', open);
      links?.classList.toggle('active', open);
      backdrop?.classList.toggle('active', open);
      toggle?.setAttribute('aria-expanded', String(open));
      document.body.style.overflow = open ? 'hidden' : '';
    }
    toggle?.addEventListener('click', () => setMenu(!toggle.classList.contains('active')));
    backdrop?.addEventListener('click', () => setMenu(false));
    links?.querySelectorAll('a').forEach(a => a.addEventListener('click', () => setMenu(false)));
  </script>
</body>
</html>
<style is:global>
  @import '../styles/global.css';
</style>
