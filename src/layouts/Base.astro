---
const { title = 'Sachin Dohdiya', description = 'Director at Asian Marmo Private Limited. Founder of FabricSG. Building muscle, a business, and a legacy. Based out of Kishangarh and Jaipur, Rajasthan.', image = '/og-image.svg' } = Astro.props;
const links = [
  { href: '/#home',        label: 'Home' },
  { href: '/#about',       label: 'About' },
  { href: '/#opensource',  label: 'Open Source' },
  { href: '/#experience',  label: 'Experience' },
  { href: '/#contact',     label: 'Contact' },
];
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="author" content="Sachin Dohdiya" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Sachin Dohdiya" />
  <meta property="og:url" content={Astro.url} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={new URL(image, Astro.url)} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="canonical" href={Astro.url} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="alternate" type="application/rss+xml" title="Sachin Dohdiya" href="/rss.xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@300;400;500&display=swap" />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Person",
    "@id": "https://sachinskywalker-site.vercel.app/#sachin",
    "name": "Sachin Dohdiya",
    "url": "https://sachinskywalker-site.vercel.app",
    "jobTitle": "Director",
    "description": "Director at Asian Marmo Private Limited, a third-generation marble business in Kishangarh and Jaipur, Rajasthan. Founder of FabricSG, a premium fabric and textile business. Mr. Rajasthan 2019. Open-sources local-first AI tooling and autonomous coding agent infrastructure under @sachin7x on GitHub.",
    "worksFor": {
      "@type": "Organization",
      "name": "Asian Marmo Private Limited",
      "url": "https://www.instagram.com/asianmarmo/"
    },
    "knowsAbout": [
      "Marble Industry",
      "Textile Business",
      "Family Business Operations",
      "Local-first AI Tooling",
      "Claude Code",
      "Autonomous Coding Agents",
      "Model Context Protocol (MCP)",
      "Bodybuilding",
      "Fitness Coaching"
    ],
    "sameAs": [
      "https://github.com/sachin7x",
      "https://www.instagram.com/sachindohdiya/",
      "https://www.facebook.com/fabricsg/"
    ]
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "ProfilePage",
    "dateModified": new Date().toISOString().slice(0, 10),
    "mainEntity": { "@id": "https://sachinskywalker-site.vercel.app/#sachin" }
  })} />
</head>
<body>
  <a href="#home" class="skip-link">Skip to content</a>
  <nav>
    <div class="nav-container">
      <div class="logo" onclick="window.scrollTo({ top: 0, behavior: 'smooth' })">sd</div>
      <button class="mobile-menu-toggle" aria-label="Toggle menu">
        <span></span>
        <span></span>
        <span></span>
      </button>
      <ul class="nav-links">
        {links.map(l => <li><a href={l.href}>{l.label}</a></li>)}
        <li><a href="/blog/">Blog</a></li>
        <li><a href="resume.pdf">Resume</a></li>
      </ul>
    </div>
    <div class="mobile-menu-backdrop"></div>
  </nav>
  <slot />
  <div id="resume-modal" class="modal">
    <div class="modal-content">
      <div class="modal-header">
        <span class="modal-title">Resume</span>
        <div class="modal-actions">
          <a href="resume.pdf" download="Sachin_Dohdiya_Resume.pdf" class="modal-download">Download ↓</a>
          <button class="modal-fullscreen" aria-label="Fullscreen" title="Fullscreen">⛶</button>
          <button class="modal-close" aria-label="Close modal">×</button>
        </div>
      </div>
      <div class="modal-body">
        <iframe src="resume.pdf" title="Sachin Dohdiya Resume"></iframe>
      </div>
    </div>
  </div>
  <script>
    // Mobile menu toggle
    const mobileMenuToggle = document.querySelector('.mobile-menu-toggle');
    const navLinks = document.querySelector('.nav-links');
    const backdrop = document.querySelector('.mobile-menu-backdrop');
    const body = document.body;

    function toggleMobileMenu(isOpen) {
      mobileMenuToggle.classList.toggle('active', isOpen);
      navLinks.classList.toggle('active', isOpen);
      backdrop.classList.toggle('active', isOpen);
      body.style.overflow = isOpen ? 'hidden' : '';
    }

    mobileMenuToggle?.addEventListener('click', () => {
      const isOpen = !navLinks.classList.contains('active');
      toggleMobileMenu(isOpen);
    });

    document.querySelectorAll('.nav-links a').forEach(link => {
      link.addEventListener('click', () => toggleMobileMenu(false));
    });

    backdrop?.addEventListener('click', () => toggleMobileMenu(false));

    // Navigation scroll effect
    const nav = document.querySelector('nav');
    window.addEventListener('scroll', () => {
      if (window.pageYOffset > 100) nav.classList.add('scrolled');
      else nav.classList.remove('scrolled');
    });

    // Smooth scrolling (respect reduced motion)
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
      anchor.addEventListener('click', function (e) {
        const target = document.querySelector(this.getAttribute('href'));
        if (target) {
          e.preventDefault();
          target.scrollIntoView({ behavior: prefersReducedMotion ? 'auto' : 'smooth' });
        }
      });
    });

    // Resume modal
    const resumeModal = document.getElementById('resume-modal');
    const resumeLink = document.querySelector('a[href="resume.pdf"]');
    const modalClose = document.querySelector('.modal-close');
    const modalFullscreen = document.querySelector('.modal-fullscreen');
    const modalContent = document.querySelector('.modal-content');

    if (resumeLink && resumeModal) {
      resumeLink.addEventListener('click', function(e) {
        e.preventDefault();
        resumeModal.classList.add('active');
        document.body.style.overflow = 'hidden';
      });
    }
    if (modalClose) {
      modalClose.addEventListener('click', () => {
        resumeModal.classList.remove('active');
        document.body.style.overflow = '';
      });
    }
    if (modalFullscreen && modalContent) {
      modalFullscreen.addEventListener('click', () => {
        if (!document.fullscreenElement) {
          modalContent.requestFullscreen().catch(() => window.open('resume.pdf', '_blank'));
        } else {
          document.exitFullscreen();
        }
      });
    }
    if (resumeModal) {
      resumeModal.addEventListener('click', (e) => {
        if (e.target === resumeModal) {
          resumeModal.classList.remove('active');
          document.body.style.overflow = '';
        }
      });
    }
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && resumeModal?.classList.contains('active')) {
        resumeModal.classList.remove('active');
        document.body.style.overflow = '';
      }
    });
  </script>
</body>
</html>
<style is:global>
  @import '../styles/global.css';
</style>
