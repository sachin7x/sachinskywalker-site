---
const { title = 'Sachin Dohdiya', description = 'Director at Asian Marmo Private Limited. Founder of FabricSG. Building muscle, a business, and a legacy. Based out of Kishangarh and Jaipur, Rajasthan.', image = '/og-image.svg' } = Astro.props;
const { pathname } = Astro.url;
const links = [
  { href: '/#about',        label: 'About' },
  { href: '/#opensource',   label: 'Open Source' },
  { href: '/#experience',   label: 'Experience' },
  { href: '/#writing',      label: 'Writing' },
  { href: '/#contact',      label: 'Contact' },
];
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="author" content="Sachin Dohdiya" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Sachin Dohdiya" />
  <meta property="og:url" content={Astro.url} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={new URL(image, Astro.url)} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="canonical" href={Astro.url} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="alternate" type="application/rss+xml" title="Sachin Dohdiya" href="/rss.xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" />
</head>
<body class="min-h-screen bg-white text-black font-sans antialiased">
  <nav id="nav" class="fixed top-0 left-0 right-0 z-50 px-12 py-8 bg-white/90 backdrop-blur-xl transition-all duration-300" style="transition: all 0.3s ease;">
    <div class="max-w-[1200px] mx-auto flex items-center justify-between">
      <a href="/" class="font-mono text-xl font-semibold tracking-tight hover:opacity-70 transition-opacity">sachindohdiya</a>
      <ul class="flex gap-10 list-none">
        {links.map(l => (
          <li>
            <a href={l.href} class="nav-link text-black/90 text-sm font-medium tracking-wide relative hover:text-black/60 transition-colors duration-300">
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </nav>
  <main>
    <slot />
  </main>
  <footer class="bg-black text-white py-16 px-12">
    <div class="max-w-[1200px] mx-auto flex flex-wrap items-center justify-between gap-6">
      <div class="text-sm text-white/70 font-mono">© {new Date().getFullYear()} Sachin Dohdiya</div>
      <div class="flex gap-6 text-sm font-mono">
        <a class="hover:text-white/60 transition-colors" href="https://github.com/sachin7x">github</a>
        <a class="hover:text-white/60 transition-colors" href="/rss.xml">rss</a>
      </div>
      <div class="text-xs text-white/40 font-mono">built with astro · vercel</div>
    </div>
  </footer>
</body>
</html>
<style is:global>
  @import '../styles/global.css';
</style>
