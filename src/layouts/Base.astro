---
const { title = 'Sachin Dohdiya', description = 'Director at Asian Marmo, founder of FabricSG. Based out of Kishangarh and Jaipur, Rajasthan.', image = '/og-image.svg' } = Astro.props;
const { pathname } = Astro.url;
const isActive = (href) => href === '/' ? pathname === '/' : pathname.startsWith(href);
const links = [
  { href: '/#about',        label: 'About' },
  { href: '/#opensource',   label: 'Open Source' },
  { href: '/#experience',   label: 'Experience' },
  { href: '/blog/',         label: 'Writing' },
  { href: '/#contact',      label: 'Contact' },
];
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="author" content="Sachin Dohdiya" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Sachin Dohdiya" />
  <meta property="og:url" content={Astro.url} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={new URL(image, Astro.url)} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="canonical" href={Astro.url} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="alternate" type="application/rss+xml" title="Sachin Dohdiya" href="/rss.xml" />
</head>
<body class="min-h-screen bg-black text-white font-sans">
  <header class="border-b border-white/10">
    <nav class="max-w-3xl mx-auto px-6 py-6 flex items-baseline gap-6 text-sm font-mono">
      <a href="/" class="font-semibold tracking-tight">sachindohdiya</a>
      <div class="ml-auto flex flex-wrap items-center gap-x-5 gap-y-2">
        {links.map(l => (
          <a href={l.href} class={isActive(l.href) ? 'text-white' : 'text-white/60 hover:text-white'}>{l.label}</a>
        ))}
      </div>
    </nav>
  </header>
  <main class="max-w-3xl mx-auto px-6 py-16">
    <slot />
  </main>
  <footer class="border-t border-white/10 mt-24 py-10 text-xs font-mono text-white/50">
    <div class="max-w-3xl mx-auto px-6 flex flex-wrap gap-6 items-center justify-between">
      <div>© {new Date().getFullYear()} Sachin Dohdiya · <a class="hover:text-white" href="https://github.com/sachin7x">github</a> · <a class="hover:text-white" href="/rss.xml">rss</a></div>
      <div class="opacity-60">built with astro · vercel</div>
    </div>
  </footer>
</body>
</html>
<style is:global>
  @import '../styles/global.css';
</style>
